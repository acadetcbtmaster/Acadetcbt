# ==============================================================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES
# ACADET CBT MASTER — ONLINE AI COMPUTER BASED TESTING PLATFORM
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SQUAD & KORAPAY PAYMENT GATEWAY CREDENTIALS (REQUIRED FOR PAYMENT FLOWS)
# Obtain these from your Squad Co Dashboard & KoraPay Merchant Dashboard
# ------------------------------------------------------------------------------

# Squad Public Key (e.g. sandbox_pk_sample_123 or pk_live_sample_123)
SQUAD_PUBLIC_KEY=sandbox_pk_test_123456789

# Squad Secret Key (e.g. sandbox_sk_sample_123 or sk_live_sample_123)
SQUAD_SECRET_KEY=sandbox_sk_test_123456789

# Squad Webhook Secret Key (Used to verify HMAC SHA512 signatures on /api/squad/webhook)
SQUAD_WEBHOOK_SECRET=sandbox_sk_test_123456789

# Squad Base API URL
# For Sandbox Testing: https://sandbox-api-d.squadco.com
# For Production Live: https://api-d.squadco.com
SQUAD_BASE_URL=https://api-d.squadco.com

# KoraPay Live Public Key (e.g. pk_live_...)
KORAPAY_PUBLIC_KEY=pk_live_test_key_123456789

# KoraPay Live Secret Key (e.g. sk_live_...)
KORAPAY_SECRET_KEY=sk_live_test_key_123456789

# KoraPay Webhook Secret Key (Used to verify HMAC SHA256 signatures on /api/webhooks/korapay)
KORAPAY_WEBHOOK_SECRET=sk_live_test_key_123456789

# KoraPay Base API URL (Live Production: https://api.korapay.com)
KORAPAY_BASE_URL=https://api.korapay.com

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------

# Main Application Public Web Domain or Railway App URL
APP_URL=https://acadetcbt.website

# Server Listen Port (Default: 3000)
PORT=3000

# Node Environment ("production" or "development")
NODE_ENV=production

# Disable HMR during agent edits (set to true for Railway deployments)
DISABLE_HMR=false

# ------------------------------------------------------------------------------
# 3. GEMINI AI ENGINE (REQUIRED FOR AI EXAM GENERATOR & MENCORE ASSISTANT)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------

GEMINI_API_KEY=AIzaSyDummyTestKey123456789ABCDEFGHIJKLMNOP

# ------------------------------------------------------------------------------
# 4. ADMINISTRATOR CREDENTIALS (FOR SECURE ADMIN DASHBOARD & VERIFICATION)
# ------------------------------------------------------------------------------

# Admin Username for Backend Admin Dashboard Access
ADMIN_USERNAME=Menmex

# Admin Password for Backend Admin Dashboard Access
ADMIN_PASSWORD=joyce@menmex

# ------------------------------------------------------------------------------
# 5. SUPABASE DATABASE CREDENTIALS (PRIMARY / PRODUCTION STORAGE)
# Obtain these from your Supabase Project Settings -> API
# Leave blank if not configured - Firebase will be used as fallback
# ------------------------------------------------------------------------------

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy

# Supabase Anon Key (Vite client-side)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy

# Supabase Service Role Key (Backend operations & migrations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy

# ------------------------------------------------------------------------------
# 6. FIREBASE / FIRESTORE DATABASE CREDENTIALS (OPTIONAL / BACKUP AUTH & STORAGE)
# Obtain from your Firebase Console -> Project Settings
# These are configured in firebase-applet-config.json but can be overridden here
# ------------------------------------------------------------------------------

# Firebase Project ID
FIREBASE_PROJECT_ID=cbt-master-b1d65

# Firebase Client Service Account Email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xyz@cbt-master-b1d65.iam.gserviceaccount.com

# Firebase Private Key (Escaped string with \n line breaks)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt9Us8cKj\n-----END PRIVATE KEY-----

# Firebase API Key (Client-side authentication)
VITE_FIREBASE_API_KEY=AIzaSyDummyTestKey123456789ABCDEFG

# Firebase Auth Domain
VITE_FIREBASE_AUTH_DOMAIN=cbt-master-b1d65.firebaseapp.com

# Firebase Project ID (Client-side)
VITE_FIREBASE_PROJECT_ID=cbt-master-b1d65

# Firebase Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=cbt-master-b1d65.appspot.com

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==============================================================================
# END OF ENVIRONMENT CONFIGURATION
# ==============================================================================
