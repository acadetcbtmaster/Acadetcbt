rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dynamic Interface Editor & System Settings
    match /interface_settings/{docId} {
      allow read, write: if true;
    }

    match /system_configs/{configId} {
      allow read, write: if true;
    }

    match /quick_links/{linkId} {
      allow read, write: if true;
    }

    match /homepage_sections/{sectionId} {
      allow read, write: if true;
    }

    // Questions, Universities, Courses, Materials
    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /universities/{uniId} {
      allow read, write: if true;
    }

    match /courses/{courseId} {
      allow read, write: if true;
    }

    match /study_materials/{materialId} {
      allow read, write: if true;
    }

    // Subscription Plans & Payments
    match /subscription_plans/{planId} {
      allow read, write: if true;
    }

    match /plans/{planId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Community & Publishing System
    match /tutorial_videos/{videoId} {
      allow read, write: if true;
    }

    match /community_posts/{postId} {
      allow read, write: if true;
    }

    match /community_announcements/{announcementId} {
      allow read, write: if true;
    }

    match /learning_resources/{resourceId} {
      allow read, write: if true;
    }

    match /topic_requests/{requestId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Catch-all default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


