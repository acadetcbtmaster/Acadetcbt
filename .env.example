# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://cbt-master-v2-production.up.railway.app)
APP_URL="https://cbt-master-v2-production.up.railway.app"

# Predefined Administrator Credentials for secure backend verification
ADMIN_USERNAME="Menmex"
ADMIN_PASSWORD="joyce@menmex"

# Firebase Project Configuration ("CBT Master")
VITE_FIREBASE_PROJECT_ID="cbt-master-b1d65"
VITE_FIREBASE_AUTH_DOMAIN="cbt-master-b1d65.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="cbt-master-b1d65.firebasestorage.app"
VITE_FIREBASE_DATABASE_ID="(default)"

# Squad Payment Gateway Configuration (SQUAD_SECRET_KEY is used for both API & Webhook HMAC Verification)
